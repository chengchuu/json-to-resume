{
  "name": "json-to-resume",
  "version": "2.3.0",
  "description": "A tool to generate the resume.",
  "author": {
    "name": "Cheng",
    "email": "mazeyqian@gmail.com",
    "url": "https://github.com/chengchuu"
  },
  "private": false,
  "scripts": {
    "dev": "webpack serve --config build/webpack.dev.conf.js",
    "e2e:install": "playwright install chromium",
    "build": "cross-env BASE_PATH=/ node build/build.js",
    "build:pages": "cross-env BASE_PATH=/json-to-resume/ node build/build.js",
    "validate:pages": "node scripts/validate-pages.js",
    "test:node": "node --test test/node/pages-path.spec.js",
    "unit": "cross-env BABEL_ENV=test karma start test/unit/karma.conf.js --single-run",
    "e2e": "playwright test",
    "test": "npm run test:node && npm run unit && npm run e2e",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "vue": "2.7.16",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.35.0",
    "@html-eslint/eslint-plugin": "^0.47.0",
    "@html-eslint/parser": "^0.47.0",
    "@playwright/test": "1.55.0",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@vue/test-utils": "^1.3.6",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-mocha": "^2.0.1",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "lint-staged": "^16.1.5",
    "mazey": "^5.9.1",
    "mini-css-extract-plugin": "^2.9.4",
    "mocha": "^11.7.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "sass": "1.77.8",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.14",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.7.16",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,vue,html}": "eslint --fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
